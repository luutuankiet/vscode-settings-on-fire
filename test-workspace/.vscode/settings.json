{
  "files.exclude": {
    "**/.git": true,
    "**/node_modules": true,
    "**/__tests__": true,
    "**/*.spec.js": true
  },
  "settingsToggle.groups": {
    "Array": {
      "on": {
        "emmet.excludeLanguages": ["markdown", "javascriptreact"]
      },
      "off": {
        "emmet.excludeLanguages": ["python", "whoopy"]
      }
    },
    "Simple value": {
      "on": { "editor.fontSize": 16 },
      "off": { "editor.fontSize": 12 }
    }
  },
  "emmet.excludeLanguages": ["python", "whoopy"],
  "editor.fontSize": 16
}

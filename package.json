{
  "name": "settings-toggle-web",
  "displayName": "Settings Toggle for Web",
  "description": "Switch named groups of VS Code settings on and off from the Command Palette. Runs in the browser on vscode.dev and github.dev as well as on the desktop.",
  "version": "2.0.0",
  "publisher": "luutuankiet",
  "author": {
    "name": "Tuan Kiet Luu",
    "url": "https://github.com/luutuankiet"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/luutuankiet/vscode-settings-toggle-web"
  },
  "homepage": "https://github.com/luutuankiet/vscode-settings-toggle-web#readme",
  "bugs": {
    "url": "https://github.com/luutuankiet/vscode-settings-toggle-web/issues"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "settings",
    "configuration",
    "toggle",
    "web extension",
    "vscode.dev"
  ],
  "icon": "logo.png",
  "galleryBanner": {
    "color": "#1F2430",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.74.0"
  },
  "main": "./dist/node/extension.js",
  "browser": "./dist/web/extension.js",
  "activationEvents": [
    "onCommand:settingsToggle.run"
  ],
  "contributes": {
    "commands": [
      {
        "title": "Toggle Setting Group",
        "command": "settingsToggle.run"
      }
    ],
    "configuration": {
      "type": "object",
      "title": "Settings Toggle for Web",
      "properties": {
        "settingsToggle.groups": {
          "type": "object",
          "default": {},
          "description": "Named groups of settings, each with an 'on' and an 'off' block."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "build": "node esbuild.js --production",
    "watch": "node esbuild.js --watch",
    "check-types": "tsc --noEmit",
    "package": "vsce package",
    "open-in-browser": "npx @vscode/test-web --browserType=chromium --extensionDevelopmentPath=. ./test-workspace"
  },
  "devDependencies": {
    "@types/vscode": "^1.74.0",
    "@vscode/vsce": "^3.2.1",
    "esbuild": "^0.24.0",
    "typescript": "^5.7.2"
  }
}

{
  "name": "settings-on-fire-cloud",
  "displayName": "Toggle settings for vs code web",
  "description": "Easily toggle between custom setting configurations",
  "version": "1.0.4",
  "publisher": "luutuankiet",
  "author": "Eric Biewener",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/luutuankiet/vscode-settings-on-fire"
  },
  "homepage": "https://github.com/luutuankiet/vscode-settings-on-fire/blob/master/README.md",
  "bugs": {
    "url": "https://github.com/luutuankiet/vscode-settings-on-fire/issues"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "settings",
    "configuration",
    "settings management",
    "configuration management",
    "toggle"
  ],
  "icon": "logo.png",
  "galleryBanner": {
    "color": "#111111",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.74.0"
  },
  "main": "./dist/node/extension.js",
  "browser": "./dist/web/extension.js",
  "activationEvents": [
    "onCommand:settingsOnFire.toggleSettings"
  ],
  "contributes": {
    "commands": [
      {
        "title": "Toggle Settings",
        "command": "settingsOnFire.toggleSettings"
      }
    ],
    "configuration": {
      "type": "object",
      "title": "Settings on 🔥! Configuration",
      "properties": {
        "settingsOnFire.toggle": {
          "type": "object",
          "default": {},
          "description": "Your toggle configurations."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "build": "node esbuild.js --production",
    "watch": "node esbuild.js --watch",
    "check-types": "tsc --noEmit",
    "package": "vsce package",
    "open-in-browser": "npx @vscode/test-web --browserType=chromium --extensionDevelopmentPath=. ./test-workspace"
  },
  "devDependencies": {
    "@types/vscode": "^1.74.0",
    "@vscode/vsce": "^3.2.1",
    "esbuild": "^0.24.0",
    "typescript": "^5.7.2"
  }
}
